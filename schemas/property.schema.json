{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property.schema.json",
  "title": "Property",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "title",
    "street_address",
    "city",
    "state",
    "zip_code",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "property_type",
    "listing_status",
    "amenities",
    "image_url",
    "property_details_url",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "pattern": "^PROP-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "street_address": {
      "type": "string",
      "minLength": 5
    },
    "city": {
      "type": "string",
      "minLength": 2
    },
    "state": {
      "type": "string",
      "enum": [
        "CA",
        "AZ",
        "NV",
        "OR",
        "WA"
      ]
    },
    "zip_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0
    },
    "square_feet": {
      "type": "integer",
      "minimum": 0
    },
    "property_type": {
      "type": "string",
      "enum": [
        "house",
        "condo",
        "townhouse",
        "apartment"
      ]
    },
    "listing_status": {
      "type": "string",
      "enum": [
        "for_sale",
        "pending",
        "sold"
      ]
    },
    "amenities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Solar Panels",
          "Attached Two-Car Garage",
          "Hardwood Floors",
          "Smart Thermostat",
          "Community Pool",
          "Covered Patio",
          "Granite Countertops",
          "Floor-to-Ceiling Windows",
          "Rooftop Terrace",
          "EV Charging Station",
          "Riverfront Views",
          "Cedar Sauna",
          "Chef Kitchen",
          "Wine Cellar",
          "In-Unit Washer and Dryer",
          "Private Balcony",
          "Fitness Center Access"
        ]
      }
    },
    "image_url": {
      "type": "string",
      "format": "uri"
    },
    "property_details_url": {
      "type": "string",
      "format": "uri"
    },
    "local_sponsors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/sponsor"
      }
    }
  },
  "$defs": {
    "sponsor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sponsor_id",
        "business_name",
        "website_url"
      ],
      "properties": {
        "sponsor_id": {
          "type": "string",
          "pattern": "^SP-[0-9]{3}$"
        },
        "business_name": {
          "type": "string",
          "minLength": 2
        },
        "website_url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "minLength": 5
        }
      }
    }
  }
}
